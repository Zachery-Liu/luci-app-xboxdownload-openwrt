#!/bin/sh

[ -z "$IPKG_INSTROOT" ] && [ "$IPKG_NO_SCRIPT" != 1 ] || exit 0
if ! /etc/init.d/xboxdownload_openwrt stop; then
	echo 'Could not stop Xbox Download before removal.' >&2
	exit 1
fi
rules=$(nft list tables) || exit 1
if printf '%s\n' "$rules" | grep -Eq '^table (ip xboxdownload_openwrt|inet xboxdownload_openwrt_ipv6)$'; then
	echo 'Xbox Download firewall rules are still active after stopping the service.' >&2
	exit 1
fi
/etc/init.d/xboxdownload_openwrt disable
