#!/bin/sh /etc/rc.common

START=95
USE_PROCD=1

. /lib/functions/network.sh
. /usr/share/xboxdownload_openwrt/common.sh

prepare_https_origins() {
	# Assign a stable IPv4 alias to each known host so 443 can reach that host's real address.
	local candidates="$RUNDIR/https-hosts"
	awk -v first="$HTTP_ADDRESS" '{ print $1, (NR == 1 ? first : "198.19.83." NR) }' "$DATA/domains" > "$candidates" &&
		resolve_https_origins "$candidates" "$lan_ip" "$upstream" > "$HTTPS_ORIGINS"
}

write_dns() {
	local host target key addresses value port=${1:-$DNS_PORT} dns6=${2:-0} upstream_file=${3:-$UPSTREAM_FILE} pid_file=dnsmasq.pid
	if [ "$#" -lt 2 ]; then
		case ",$ipv6_devices," in */dns,*) dns6=1 ;; esac
	fi
	[ "$port" = "$DNS_PORT" ] || pid_file="dnsmasq.$port.pid"
	printf '%s\n' "port=$port" "listen-address=$lan_ip,127.0.0.1" \
		"pid-file=$RUNDIR/$pid_file" 'no-resolv' 'cache-size=64' 'dns-forward-max=32'
	if [ "$dns6" = 1 ]; then
		printf '%s\n' "interface=$lan_dev" 'bind-dynamic'
	else
		printf '%s\n' 'bind-interfaces'
	fi
	if [ -n "$upstream" ]; then
		printf 'servers-file=%s\n' "$upstream_file"
	else
		printf 'server=%s#53\n' "$lan_ip"
	fi
	printf 'host-record=%s,%s\n' "$HEALTH_HOST" "$lan_ip"
	if [ "$log_mode" = all ]; then
		printf '%s\n' 'log-queries=extra' 'log-facility=local5' 'log-async=8'
	fi
	[ "$filter_aaaa" != 1 ] || printf '%s\n' 'filter-AAAA'

	while read -r host target; do
		value=
		case "$host:$target" in
			*.xboxlive.com:*) value=$global_ip ;;
			*:blzddist1-a.akamaihd.net) [ -n "$battle_ip" ] || continue ;;
		esac
		if [ -z "$value" ] && [ "${mode:-redirect}" = redirect ]; then
			value=$(awk -v host="$host" '$1 == host { print $2; exit }' "$HTTPS_ORIGINS" 2>/dev/null)
			[ -z "$value" ] || printf 'local=/%s/\n' "$host"
		elif [ "$dns6" = 1 ] && [ -n "$value" ] && ipv4 "$value"; then
			printf 'local=/%s/\n' "$host"
		fi
		[ -z "$value" ] || printf 'host-record=%s,%s\n' "$host" "$value"
	done < "$DATA/domains"

	if [ "${mode:-redirect}" = redirect ] || [ -n "$global_ip" ]; then
		for host in assets-srvs.xboxlive.com assets-srvs-net.trafficmanager.net \
			assets-srvs-apac.delivery.microsoft.com assets-srvs-na.delivery.microsoft.com; do
			printf 'srv-host=%s,assets1.xboxlive.com,80,0,0\n' "$host"
		done
	fi
	while read -r key addresses; do
		eval "value=\${$key}"
		[ -n "$value" ] || continue
		node_family_supported "$key" "$value" || continue
		printf 'host-record=%s,%s\n' "$addresses" "$value"
		if [ "$dns6" = 1 ] && ipv4 "$value"; then
			printf 'local=/%s/\n' "$(printf '%s' "$addresses" | tr ',' '/')"
		fi
	done < "$DATA/cdn-hosts"
}

write_device_dns() (
	local route=$1 port=$2 policy=$3 key value dns6=0 upstream_file=$UPSTREAM_FILE
	if [ -n "$route" ]; then
		read_device_route "$route"
		upstream_file="$RUNDIR/upstream.$port"
		[ -z "$upstream" ] || write_upstream "$upstream" "$upstream_file" || exit 1
	fi
	case "$policy" in
		dns) dns6=1; filter_aaaa=0 ;;
		block)
			for key in $NODE_KEYS; do
				eval "value=\${$key}"
				case "$value" in *:*) eval "$key=" ;; esac
			done
			;;
	esac
	write_dns "$port" "$dns6" "$upstream_file"
)

prepare_dns_profiles() {
	local address row route mac policy port=$DNS_PORT preferred shared_ipv6=0 key value
	: > "$DNS_PROFILES" || return 1
	for key in $NODE_KEYS; do
		eval "value=\${$key}"
		node_family_supported "$key" "$value" || continue
		case "$value" in *:*) shared_ipv6=1; break ;; esac
	done
	for address in $(printf '%s\n' "$client" | tr ',' ' '); do
		row=$(printf '%s\n' "$ipv6_devices" | tr ',' '\n' | awk -F/ -v ip="$address" '$1 == ip { print; exit }')
		policy=${row##*/}
		mac=${row#*/}
		mac=${mac%%/*}
		route=$(device_route "$address")
		case "$policy:$filter_aaaa:$shared_ipv6:$route" in block:?:1:*|dns:1:*|*:*:*:?*) ;; *) continue ;; esac
		port=$((port + 1))
		preferred=inherit
		if [ -n "$route" ]; then
			preferred=$(printf '%s\n' "$route" | cut -d/ -f3)
			preferred=${preferred:-system}
		fi
		write_device_dns "$route" "$port" "$policy" > "$RUNDIR/dnsmasq.$port.conf" &&
			/usr/sbin/dnsmasq --test -C "$RUNDIR/dnsmasq.$port.conf" >/dev/null 2>&1 &&
			printf '%s %s %s %s %s\n' "$port" "$address" "${mac:--}" "${policy:-system}" "$preferred" >> "$DNS_PROFILES" || return 1
	done
}

write_profile_dns_rules() {
	local family=$1 port address mac policy preferred
	[ -s "$DNS_PROFILES" ] || return 0
	while read -r port address mac policy preferred; do
		if [ "$family" = 4 ]; then
			printf 'iifname "%s" ip saddr %s ip daddr %s meta l4proto { tcp, udp } th dport 53 dnat to %s:%s\n' \
				"$lan_dev" "$address" "$lan_ip" "$lan_ip" "$port"
		elif [ "$policy" = dns ]; then
			printf 'iifname "%s" ether saddr %s meta nfproto ipv6 meta l4proto { tcp, udp } th dport 53 fib daddr . iif type local redirect to :%s\n' \
				"$lan_dev" "$mac" "$port"
		fi
	done < "$DNS_PROFILES"
}

write_ipv6_dns_firewall() {
	local accept_dns6=
	if [ "$2" != bypass ]; then
		accept_dns6="iifname \"$lan_dev\" ether saddr @dns_clients meta nfproto ipv6 meta l4proto { tcp, udp } th dport { $dns_ports } ct status dnat accept"
		cat <<-EOF
		set dns_clients { type ether_addr; elements = { $1 }; }
			chain dns6_request_zone {
				type filter hook prerouting priority raw; policy accept;
				iifname "$lan_dev" ether saddr @dns_clients meta nfproto ipv6 meta l4proto { tcp, udp } th dport 53 fib daddr . iif type local ct zone set $DNS_ZONE
			}
			chain dns6_reply_zone {
				type filter hook output priority raw; policy accept;
				oifname "$lan_dev" meta nfproto ipv6 meta l4proto { tcp, udp } th sport { $dns_ports } ct zone set $DNS_ZONE
			}
			chain select_xbox_ipv6_dns {
				type nat hook prerouting priority -101; policy accept;
				$(write_profile_dns_rules 6)
				iifname "$lan_dev" ether saddr @dns_clients meta nfproto ipv6 meta l4proto { tcp, udp } th dport 53 fib daddr . iif type local counter redirect to :$DNS_PORT
			}
	EOF
	fi
	cat <<-EOF
			chain restrict_dns6_port {
				type filter hook input priority -1; policy accept;
			$accept_dns6
			iifname != "lo" meta nfproto ipv6 meta l4proto { tcp, udp } th dport { $dns_ports } drop
			}
	EOF
}

write_ipv6_block_firewall() {
	cat <<-EOF
			set blocked_clients { type ether_addr; elements = { $1 }; }
			chain restrict_xbox_ipv6_dns {
				type filter hook input priority -5; policy accept;
				iifname "$lan_dev" ether saddr @blocked_clients meta nfproto ipv6 meta l4proto { tcp, udp } th dport 53 counter reject with icmpv6 type admin-prohibited
			}
			chain restrict_xbox_ipv6_forward {
				type filter hook forward priority -5; policy accept;
				iifname "$lan_dev" ether saddr @blocked_clients ip6 daddr 2000::/3 counter reject with icmpv6 type admin-prohibited
			}
	EOF
}

write_firewall() {
	local policy=${1:-active} http_rule='' tcp_ports dns_ports=$DNS_PORT dns_macs blocked_macs='' row address mac guard='' accept_dns='' accept_tcp=''
	local http_request_zone='' http_reply_zone='' https_rule='' https_map='' http_addresses
	if [ -s "$DNS_PROFILES" ]; then
		dns_ports="$dns_ports$(awk '{ printf ", %s", $1 }' "$DNS_PROFILES")"
	fi
	tcp_ports=$dns_ports
	for row in $(printf '%s' "$ipv6_devices" | tr ',' ' '); do
		address=${row%%/*}
		mac=${row#*/}
		mac=${mac%/*}
		[ -n "$mac" ] || continue
		guard="${guard:+$guard
}iifname \"$lan_dev\" ip saddr $address ether saddr != $mac return"
	done
	if [ "${mode:-redirect}" = redirect ]; then
		http_addresses=$(awk '{ printf "%s%s", separator, $2; separator=", " }' "$HTTPS_ORIGINS" 2>/dev/null)
		if [ -n "$http_addresses" ] && [ "$policy" != bypass ]; then
			http_rule="iifname \"$lan_dev\" ip saddr { $client } ip daddr { $http_addresses } tcp dport 80 dnat to $lan_ip:$HTTP_PORT"
			http_request_zone="iifname \"$lan_dev\" ip saddr { $client } ip daddr { $http_addresses } tcp dport 80 ct zone set $HTTP_ZONE"
			https_rule="iifname \"$lan_dev\" ip saddr { $client } meta l4proto { tcp, udp } th dport 443 dnat to ip daddr map @https_origins"
			https_map='map https_origins { type ipv4_addr : ipv4_addr; }'
		fi
		http_reply_zone="oifname \"$lan_dev\" ip saddr $lan_ip ip daddr { $client } tcp sport $HTTP_PORT ct zone set $HTTP_ZONE"
		tcp_ports="$dns_ports, $HTTP_PORT"
	fi
	cat <<-EOF
		destroy table ip xboxdownload_openwrt
		destroy table inet xboxdownload_openwrt_ipv6
		table ip xboxdownload_openwrt {
		$https_map
	EOF
	if [ "$policy" != bypass ]; then
		accept_dns="ip daddr $lan_ip udp dport { $dns_ports } ct status dnat iifname \"$lan_dev\" ip saddr { $client } accept"
		accept_tcp="ip daddr $lan_ip tcp dport { $tcp_ports } ct status dnat iifname \"$lan_dev\" ip saddr { $client } accept"
		cat <<-EOF
			# Leave the private conntrack zones when interception is disabled.
			chain request_zone {
				type filter hook prerouting priority raw; policy accept;
				$guard
				iifname "$lan_dev" ip saddr { $client } ip daddr $lan_ip meta l4proto { tcp, udp } th dport 53 ct zone set $DNS_ZONE
				$http_request_zone
			}
			chain reply_zone {
				type filter hook output priority raw; policy accept;
				ip saddr $lan_ip ip daddr { $client } meta l4proto { tcp, udp } th sport { $dns_ports } ct zone set $DNS_ZONE
				$http_reply_zone
			}
			chain select_xbox {
				type nat hook prerouting priority -101; policy accept;
				$guard
				$(write_profile_dns_rules 4)
				iifname "$lan_dev" ip saddr { $client } ip daddr $lan_ip udp dport 53 dnat to $lan_ip:$DNS_PORT
				iifname "$lan_dev" ip saddr { $client } ip daddr $lan_ip tcp dport 53 dnat to $lan_ip:$DNS_PORT
				$http_rule
				$https_rule
			}
	EOF
	fi
	cat <<-EOF
			chain restrict_ports {
				type filter hook input priority -1; policy accept;
				$accept_dns
				$accept_tcp
				# Router-originated health probes arrive over loopback.
				iifname != "lo" ip daddr $lan_ip udp dport { $dns_ports } drop
				iifname != "lo" ip daddr $lan_ip tcp dport { $tcp_ports } drop
			}
		}
	EOF
	dns_macs=$(ipv6_policy_macs dns)
	[ "$policy" = bypass ] || blocked_macs=$(ipv6_policy_macs block)
	[ -n "$dns_macs$blocked_macs" ] || return 0
	printf '%s\n' 'table inet xboxdownload_openwrt_ipv6 {'
	[ -z "$dns_macs" ] || write_ipv6_dns_firewall "$dns_macs" "$policy"
	[ -z "$blocked_macs" ] || write_ipv6_block_firewall "$blocked_macs"
	printf '%s\n' '}'
}

report_error() {
	printf '%s\n' "$1" > "$RUNDIR/error"
	logger -t xboxdownload_openwrt "$1"
	return 1
}

prepare_instance() {
	rm -f "$RUNDIR/ready" "$RUNDIR/owner" "$RUNDIR/error" "$UPSTREAM_STATE" &&
		printf '%s\n' "$1" > "$RUNDIR/instance"
}

start_service() {
	local validation token dns_ipv6='' use_default_upstream
	mkdir -p "$RUNDIR"
	rm -f "$RUNDIR/error"
	load_settings
	[ "$enabled" = 1 ] || return 0

	lan_network || { report_error 'LAN IPv4 unavailable'; return 1; }
	validation=$(validate_settings) || { report_error "Invalid settings: $validation"; return 1; }
	client=$(normalize_clients "$client")
	ipv6_devices=$(normalize_ipv6_devices "$ipv6_devices")
	case ",$ipv6_devices," in
		*/dns,*)
			dns_ipv6=$(ip -6 addr show dev "$lan_dev" scope link |
				awk '/inet6/ && !/tentative|dadfailed/ { split($2, address, "/"); print address[1]; exit }')
			[ -n "$dns_ipv6" ] || { report_error 'LAN IPv6 unavailable'; return 1; }
			dns_ipv6="[$dns_ipv6%$lan_dev]:$DNS_PORT"
			;;
	esac

	if [ -n "$upstream" ]; then
		write_upstream "$upstream" || { report_error 'Could not set DNS upstream'; return 1; }
	fi
	if [ "$mode" = redirect ]; then
		prepare_https_origins || { report_error 'Could not prepare HTTPS origins'; return 1; }
	else
		: > "$HTTPS_ORIGINS"
	fi
	write_dns > "$RUNDIR/dnsmasq.conf"
	{ /usr/sbin/dnsmasq --test -C "$RUNDIR/dnsmasq.conf" >/dev/null 2>&1 && prepare_dns_profiles; } ||
		{ report_error 'dnsmasq configuration failed'; return 1; }
	use_default_upstream=$(awk -v clients="$client" '
		$5 == "inherit" { inherited = 1 }
		END { print (inherited || NR < split(clients, addresses, ",")) ? 1 : 0 }
	' "$DNS_PROFILES")
	write_firewall > "$RUNDIR/rules.nft" &&
	write_firewall bypass > "$RUNDIR/bypass.nft" &&
	nft -c -f "$RUNDIR/rules.nft" && nft -c -f "$RUNDIR/bypass.nft" ||
		{ report_error 'Invalid nftables rules'; return 1; }

	printf '%s %s\n' "$log_mode" "$log_path" > "$RUNDIR/http-log"
	token=$(cat /proc/sys/kernel/random/uuid) || return 1
	with_service_lock prepare_instance "$token" || return 1
	procd_open_instance service
	procd_set_param command "$DATA/supervise" "$token" "$lan_ip" "$mode" "$upstream" "$dns_ipv6" "$probe_domain" "$use_default_upstream"
	procd_set_param respawn 3600 1 5
	procd_set_param term_timeout 3
	procd_set_param stderr 1
	procd_close_instance
}

remove_instance() {
	local stopped=0
	rm -f "$RUNDIR/instance" "$RUNDIR/owner" "$RUNDIR/ready" "$RUNDIR/error" "$UPSTREAM_STATE" || stopped=1
	clear_rules || stopped=1
	return "$stopped"
}

stop_service() {
	with_service_lock remove_instance
}

reload_service() {
	restart
}

service_triggers() {
	procd_add_reload_interface_trigger lan
}
