#!/bin/sh

[ -z "$IPKG_INSTROOT" ] && [ "$IPKG_NO_SCRIPT" != 1 ] || exit 0
legacy='xbox''accel'
init="/etc/init.d/$legacy"
[ -x "$init" ] || exit 0

runtime=/var/run/xboxdownload_openwrt
mkdir -p "$runtime" || exit 1
backup=
trap '[ -z "$backup" ] || rm -f "$backup"' EXIT
if [ -f "/etc/config/$legacy" ]; then
	backup=$(mktemp "$runtime/migrate.XXXXXX") || exit 1
	uci -q export "$legacy" > "$backup" || exit 1
fi
if ! "$init" stop || ! "$init" disable; then
	echo 'Could not stop and disable the legacy Xbox Download service before migration.' >&2
	exit 1
fi
[ -z "$backup" ] || mv -f "$backup" "$runtime/legacy.uci"
